{
  "name": "poker-online",
  "private": true,
  "type": "module",
  "description": "Poker multiplayer Android — monorepo (nome provvisorio)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "test:engine": "pnpm --filter @poker/poker-engine run test",
    "test:contracts": "pnpm --filter @poker/contracts --filter @poker/server-domain run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
