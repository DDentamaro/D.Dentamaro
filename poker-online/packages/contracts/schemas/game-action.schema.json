{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.poker.local/v1/game-action.schema.json",
  "title": "Comando client game.action (§11.4)",
  "description": "Il principal deriva dalla sessione: nessun campo attore nel payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "type", "commandId", "matchId", "handId", "turnId", "expectedVersion", "payload"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "type": { "const": "game.action" },
    "commandId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "matchId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "handId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "turnId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expectedVersion": { "$ref": "defs.schema.json#/$defs/version" },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["FOLD", "CHECK", "CALL"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "streetTotal"],
          "properties": {
            "kind": { "const": "RAISE_TO" },
            "streetTotal": { "$ref": "defs.schema.json#/$defs/chips" }
          }
        }
      ]
    }
  }
}
