# Copiare in .env per lo sviluppo locale. Nessun segreto reale in questo file (§19.4).
APP_ENV=local
DATABASE_URL=
REDIS_URL=
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# Consentito solo in ambienti non di produzione.
AUTH_EMULATOR_HOST=
GAME_REGION=eu
BOT_POOL_SIZE=50
BOT_FILL_AFTER_SECONDS=20
# DEVE restare false: il bootstrap del server rifiuta true (invariante ranked solo umani).
ALLOW_RANKED_BOTS=false
PLAY_PURCHASES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Riferimento alla chiave nel secret manager, non la chiave stessa.
SECRET_STATE_KEY_REF=
